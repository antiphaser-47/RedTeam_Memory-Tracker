# ============================================================================
# Makefile - CoreSight-style real-time memory tracker
# ----------------------------------------------------------------------------
# Integration: one entry point builds every deliverable.
# Packaging:   `make package` collects them into dist/.
#
# Deliverables
#   make user      -> tracker_linux        (Linux user space, primary target)
#   make win       -> tracker.exe          (Windows x64, cross-compiled)
#   make kmod      -> memory_tracker.ko    (Linux kernel module)
#   make preload   -> libtracker_preload.so (optional LD_PRELOAD shim)
#   make test      -> unit tests + localhost functional test + shim test
#   make package   -> dist/ bundle (binaries + scripts + docs)
# ============================================================================

CC          ?= gcc
CROSS_CC    ?= x86_64-w64-mingw32-gcc
PKG_CONFIG  ?= pkg-config

# ---- third-party: Capstone cross-compiled for the MinGW target ------------
# The Linux build uses the distro's libcapstone-dev through pkg-config.
# The Windows build cannot link that (it is an ELF library), so we ship a
# MinGW-built static archive under third_party/ - see third_party/README.md
# for exactly how it was produced.
TP_CAPSTONE := third_party/capstone

# ---- common flags ----------------------------------------------------------
INC         := -Iinclude
WARN        := -Wall -Wextra -Wno-unused-parameter
OPT         := -O2 -g
# gnu11 (not c11) so that POSIX interfaces such as localtime_r, pthreads and
# backtrace() are declared without extra feature-test macros.
CFLAGS      := -std=gnu11 $(OPT) $(WARN) $(INC) -MMD -MP
LDLIBS_USER := -lpthread -lm -ldl -rdynamic

# Capstone (ROP verification) - detected through pkg-config when available.
CAPSTONE_CFLAGS := $(shell $(PKG_CONFIG) --cflags capstone 2>/dev/null)
CAPSTONE_LIBS   := $(shell $(PKG_CONFIG) --libs capstone 2>/dev/null)
ifeq ($(CAPSTONE_LIBS),)
CAPSTONE_LIBS := -lcapstone
endif
CFLAGS += $(CAPSTONE_CFLAGS)

# ---- layout ----------------------------------------------------------------
BUILD   := build
OBJ     := $(BUILD)/obj
DIST    := dist

CORE_SRC := $(wildcard src/core/*.c)
CORE_OBJ := $(patsubst src/%.c,$(OBJ)/%.o,$(CORE_SRC))

LINUX_SRC := $(wildcard src/linux/*.c)
LINUX_OBJ := $(patsubst src/%.c,$(OBJ)/%.o,$(LINUX_SRC))

# Windows objects are built with the cross compiler into their own tree:
# an ELF object produced by the host gcc can never be linked into a PE file.
WIN_SRC      := $(wildcard src/win/*.c)
WIN_OBJ      := $(patsubst src/win/%.c,$(OBJ)/win/%.o,$(WIN_SRC))
WIN_CORE_OBJ := $(patsubst src/core/%.c,$(OBJ)/win/core/%.o,$(CORE_SRC))

TEST_SRC := $(wildcard tests/test_*.c)
TEST_BIN := $(patsubst tests/%.c,$(BUILD)/%,$(TEST_SRC))

# The LD_PRELOAD shim is a shared object, so every object it links must be
# position independent while the main binary's objects are not.
PIC_DIR := $(OBJ)/pic
PIC_OBJ := $(PIC_DIR)/preload_shim.o $(PIC_DIR)/logger.o

# Header dependency files generated by -MMD -MP.  Without these, editing an
# header (e.g. adding a field to PlatformOps) silently leaves stale objects
# in build/ and produces a binary with mismatched struct layouts.
DEPS := $(CORE_OBJ:.o=.d) $(LINUX_OBJ:.o=.d) \
        $(WIN_CORE_OBJ:.o=.d) $(WIN_OBJ:.o=.d) \
        $(PIC_OBJ:.o=.d) \
        $(patsubst tests/%.c,$(BUILD)/%.d,$(TEST_SRC))
-include $(DEPS)

.PHONY: all core user win kmod preload test unit-test functional-test \
        shim-test kmod-test package clean help

all: user

help:
	@echo "Targets:"
	@echo "  make user       - Linux user space binary (tracker_linux)"
	@echo "  make win        - Windows x64 binary (tracker.exe, cross-compile)"
	@echo "  make kmod       - Linux kernel module (memory_tracker.ko)"
	@echo "  make preload    - optional LD_PRELOAD shim"
	@echo "  make test       - unit tests + localhost functional test + shim test"
	@echo "  make kmod-test  - kernel module test (load half needs root)"
	@echo "  make package    - assemble dist/"
	@echo "  make clean      - remove build artifacts"

# ---- core static library ---------------------------------------------------
core: $(BUILD)/libtracker_core.a

$(BUILD)/libtracker_core.a: $(CORE_OBJ)
	@mkdir -p $(dir $@)
	ar rcs $@ $^

$(OBJ)/core/%.o: src/core/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

# ---- Linux user space binary ----------------------------------------------
user: $(BUILD)/tracker_linux

$(BUILD)/tracker_linux: $(CORE_OBJ) $(LINUX_OBJ)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $^ -o $@ $(CAPSTONE_LIBS) $(LDLIBS_USER)

$(OBJ)/linux/%.o: src/linux/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

# ---- Windows x64 (cross-compiled, no execution on this host) ---------------
# Everything here is compiled with the MinGW toolchain: separate object
# directory, separate Capstone (the Linux one is an ELF archive) and a
# fully static link so tracker.exe has no DLL dependencies beyond the ones
# every Windows box already has.
WIN_CFLAGS := -std=gnu11 $(OPT) $(WARN) $(INC) -MMD -MP \
              -I$(TP_CAPSTONE)/include \
              -D__USE_MINGW_ANSI_STDIO=1 \
              -D_POSIX_THREAD_SAFE_FUNCTIONS=200112L
WIN_LIBS   := -static -L$(TP_CAPSTONE)/lib -lcapstone \
              -lpsapi -lntdll -lwinpthread -lm

win: $(BUILD)/tracker.exe

$(BUILD)/tracker.exe: $(WIN_CORE_OBJ) $(WIN_OBJ)
	@mkdir -p $(dir $@)
	$(CROSS_CC) $(WIN_CFLAGS) $^ -o $@ $(WIN_LIBS)

$(OBJ)/win/core/%.o: src/core/%.c
	@mkdir -p $(dir $@)
	$(CROSS_CC) $(WIN_CFLAGS) -c $< -o $@

$(OBJ)/win/%.o: src/win/%.c
	@mkdir -p $(dir $@)
	$(CROSS_CC) $(WIN_CFLAGS) -c $< -o $@

# ---- Linux kernel module ---------------------------------------------------
# Built inside src/kmod with the kernel build system; the .ko is then copied
# into build/ next to the user-space binaries so `make package` can find it.
kmod:
	$(MAKE) -C src/kmod
	@mkdir -p $(BUILD)
	cp src/kmod/memory_tracker.ko $(BUILD)/

# ---- optional LD_PRELOAD shim ---------------------------------------------
preload: $(BUILD)/libtracker_preload.so

# A shared object has to link position-independent code, and the objects of
# the main binary are built without -fPIC.  The shim therefore gets its own
# small PIC object tree (only logger.c is shared with it); the object list
# itself is declared next to the other source lists above.

$(BUILD)/libtracker_preload.so: $(PIC_OBJ)
	@mkdir -p $(dir $@)
	$(CC) -shared $^ -o $@ -ldl -lpthread

$(PIC_DIR)/preload_shim.o: src/linux/preload_shim.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -fPIC -c $< -o $@

$(PIC_DIR)/logger.o: src/core/logger.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -fPIC -c $< -o $@

# ---- tests -----------------------------------------------------------------
unit-test: $(TEST_BIN)
	@set -e; for t in $(TEST_BIN); do echo "== $$t"; $$t; done

$(BUILD)/test_%: tests/test_%.c $(CORE_OBJ)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $< $(CORE_OBJ) -o $@ $(CAPSTONE_LIBS) $(LDLIBS_USER)

functional-test: user
	bash tests/run_test.sh

# The LD_PRELOAD shim is a separate Linux-only deliverable, so it gets its
# own report (build/shim_test_report.txt) instead of changing the 46
# assertion baseline of run_test.sh.
shim-test: preload
	bash tests/test_shim.sh

test: unit-test functional-test shim-test

# The kernel module needs a matching kernel build tree to compile and root
# privileges to load, so it is deliberately *not* part of `make test`.
# Without root the script still verifies the built .ko and reports the load
# half as SKIP.
kmod-test: kmod
	bash tests/test_kmod.sh

# ---- packaging -------------------------------------------------------------
# Rebuild dist/ from scratch: a stale copy (or a stray log left behind by a
# manual run) must never leak into the release bundle.  kmod is included, so
# packaging requires kernel headers.
package: user win preload kmod
	rm -rf $(DIST)
	@mkdir -p $(DIST)/docs $(DIST)/tests
	cp $(BUILD)/tracker_linux $(DIST)/
	cp $(BUILD)/tracker.exe   $(DIST)/
	cp $(BUILD)/libtracker_preload.so $(DIST)/
	cp $(BUILD)/memory_tracker.ko $(DIST)/
# test_win.bat is only an entry point: it shells out to test_win.ps1, so the
# .ps1 must travel with it or the Windows test cannot run from dist/.
	cp tests/run_test.sh tests/test_win.bat tests/test_win.ps1 \
	   tests/test_shim.sh tests/test_kmod.sh $(DIST)/tests/
	cp docs/USAGE.md $(DIST)/docs/
	@echo "packaged -> $(DIST)/"
clean:
	rm -rf $(BUILD) $(DIST)
	-$(MAKE) -C src/kmod clean 2>/dev/null || true
